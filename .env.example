# ========================================================
# Lyftr AI Chatbot Configuration
# ========================================================

# Comma-separated API key pool (at least 2 keys in priority order: key_1, key_2, ...)
LLM_API_KEYS=your_primary_api_key_here,your_fallback_api_key_here

# SQLite Database URL
# In Docker: sqlite:////data/app.db (persisted on /data volume)
# Local: sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (comma-separated origins or * for all)
ALLOWED_ORIGINS=*

# Failover test hook switch (true enables X-Simulate-Failure inspection)
ENABLE_FAILURE_SIMULATION=true

# Model Routing Configuration
PRIMARY_MODEL=gemini/gemini-3.5-flash
FALLBACK_MODEL=groq/openai/gpt-oss-20b
LLM_TIMEOUT=35.0

# Default System Prompt for new conversations
DEFAULT_SYSTEM_PROMPT=You are Lyftr AI, a helpful and structured assistant. Format your responses using clean GitHub Flavored Markdown (GFM). Whenever appropriate for comparisons, multi-attribute concepts, key features, or structured specifications, include well-formatted Markdown tables, distinct headers, and bold bullet points for maximum clarity.

# Optional: Frontend API Base URL (leave empty for relative/nginx proxy or set to http://localhost:8000)
VITE_API_BASE_URL=

